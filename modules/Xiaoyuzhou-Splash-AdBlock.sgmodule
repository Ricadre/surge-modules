#!name=小宇宙广告过滤（测试版）
#!desc=过滤开屏，以及首页明确标记为运营推广或广告的横幅；保留普通推荐、编辑精选、榜单和顶部功能入口。需 Surge iOS 5.14+、重写、MITM 及已信任证书。更新后彻底退出并重开，缓存内容可能需后续启动才消失。
#!version=0.2.0
#!homepage=https://github.com/nuvora-f44c84/surge-modules

# 独立模块，无外部脚本和整域名封锁。
# 仅匹配完整开屏列表和首页列表路径；不清空首页、搜索、分类或 AI 功能。
# 接口线索与验证状态见 docs/xiaoyuzhou-splash.txt。
[Map Local]
^https://api\.xiaoyuzhoufm\.com/v1/flash-screen/list/?(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
# 只处理 DISCOVERY_BANNER 中明确标记的推广，保留未标记横幅和分页字段。
# 未知结构原样保留；JSON 类型异常时返回原始内容。
http-response-jq ^https://api\.xiaoyuzhoufm\.com/v1/discovery-feed/list/?(?:\?.*)?$ '. as $original | try (if type == "object" and (.data | type) == "array" then .data |= map(if type == "object" and .type == "DISCOVERY_BANNER" and (.data | type) == "array" then .data |= map(select(if type == "object" then (.presetPurpose != "OPERATIONAL" and .showAdIndicator != true) else true end)) | select(.data | length > 0) else . end) else . end) catch $original'

[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com
